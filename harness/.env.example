# Copy to .env and fill in. .env is gitignored.

# Your API key for the model provider.
HARNESS_API_KEY=

# API base URL. Requests go to <base>/chat/completions (openai) or <base>/messages (anthropic),
# and the model list comes from <base>/models. Check your provider's docs for the exact base URL.
HARNESS_BASE_URL=https://apinex.bond/v1

# openai = OpenAI-compatible Chat Completions, anthropic = Anthropic Messages API.
HARNESS_API_FORMAT=openai

# auto (Bearer for openai, x-api-key for anthropic) | bearer | x-api-key | both
HARNESS_AUTH_HEADER=auto

HARNESS_MODEL=gemini-4-argon

# Folder the model's tool calls (Bash, Read, Write, Edit, Glob, Grep) run in. Relative to harness/.
HARNESS_WORKSPACE=workspace

HARNESS_PORT=8787
